#!/usr/bin/env bash

programs=(zen nautilus easyeffects gnome-software xdg-desktop-por)
nostartbrowser=false

while getopts "ln" opt; do
    case $opt in
        l) ls ~/.config/wallust/colorschemes/ | sed 's/\.json//'; exit 0 ;;
        n) unset programs[0]; nostartbrowser=true ;; # don't restart browser
        \?) exit 1 ;;
    esac
done
shift $((OPTIND - 1))

for i in "${programs[@]}"; do
    pkill $i
done

if [[ $(pgrep -f pear-desktop) ]]; then
    YTM=true
    pkill -fo pear-desktop # special pkill for youtube music
fi

if [[ -n $1 ]]; then
    wallust cs $1 -q
    dms ipc wallpaper set ~/Pictures/Wallpapers/$1/"$(ls ~/Pictures/Wallpapers/$1/ | head -n 1)"
fi

if [[ $nostartbrowser -eq false ]]; then
    niri msg action spawn -- zen-browser
    echo ahh
else
    echo ahhhh
fi
niri msg action spawn -- easyeffects
if [[ $YTM -eq true ]]; then
    niri msg action spawn -- pear-desktop
fi
