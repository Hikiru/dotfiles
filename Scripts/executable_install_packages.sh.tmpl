{{ if eq .osid "linux-cachyos" -}}
#!/usr/bin/env bash

if [ !"$(type -p paru)" ]; then
    echo "Paru not installed, installing it."
    sudo pacman -S --needed base-devel rustup
    rustup default stable
    git clone https://aur.archlinux.org/paru.git
    cd paru
    makepkg -si
fi

if [ !"$(type -p flatpak)" ]; then
    echo "Flatpak not installed, installing it."
    sudo pacman -S flatpak
fi

paru -Syu --needed {{ .packages.cachyos | join " " }}
flatpak install {{ .packages.flatpak | join " " }}

read -p "Do you want to install flatscreen gaming packages? (y/n) " flatscreen

case $flatscreen in
    [yY] )
        echo "Installing flatscreen gaming packages..."
        paru -Syu --needed {{ .packages.gaming.flatscreen | join " " }}
        echo "Opening Steam streaming ports"
        sudo ufw allow 27031/udp
        sudo ufw allow 27036/udp
        sudo ufw allow 27036/tcp
        sudo ufw allow 27037/tcp
        sudo ufw allow 10400/udp
        sudo ufw allow 10405/udp
        ;;
    [nN] )
        ;;
    [*] )
        echo "Invalid response.";;
esac

read -p "Do you want to install WiVRn for VR streaming?? (y/n) " vr

case $vr in
    [yY] )
        echo "Installing WiVRn..."
        paru -Syu --needed {{ .packages.gaming.vr | join " " }}
        echo "Opening WiVRn ports..."
        ufw allow 5353/udp
        ufw allow 9757
        ;;
    [nN] )
        ;;
    [*] )
        echo "Invalid response.";;
esac

{{ end -}}
